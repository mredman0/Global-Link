  m_TableData:
  - m_Id: 440582557696
    m_Localized: "ChromaSphere\uC5D0 \uC624\uC2E0 \uAC83\uC744 \uD658\uC601\uD569\uB2C8\uB2E4.\n\n(\uD0ED\uD558\uC5EC
      \uACC4\uC18D \uC9C4\uD589)"
    m_Metadata:
      m_Items: []
  - m_Id: 7603900141568
    m_Localized: "\uC5EC\uAE30\uC5D0\uC11C \uC124\uC815\uC744 \uBCC0\uACBD\uD560
      \uC218 \uC788\uC73C\uBA70, \uC5EC\uAE30\uC5D0\uB294 \uBC18\uC804\uB41C \uCEE8\uD2B8\uB864\uACFC
      \uC811\uADFC\uC131 \uC635\uC158\uC774 \uD3EC\uD568\uB429\uB2C8\uB2E4.\n\n(\uD0ED\uD558\uC5EC
      \uACC4\uC18D \uC9C4\uD589)"
    m_Metadata:
      m_Items: []
  - m_Id: 8543478763520
    m_Localized: "\uD654\uBA74\uC744 \uB530\uB77C \uB4DC\uB798\uADF8\uD558\uC5EC
      ChromaSphere\uB97C \uD68C\uC804\uC2DC\uCF1C \uBCF4\uC138\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 9257491910656
    m_Localized: "\uC791\uC740 \uBE68\uAC04 \uACF5\uB4E4\uC740 Chroma\uC785\uB2C8\uB2E4.
      \uAC19\uC740 \uC0C9\uC0C1\uC758 \uB2E4\uB978 Chroma\uC640 \uC5F0\uACB0\uD574\uC57C
      \uD569\uB2C8\uB2E4.\n\n\uC2DC\uC791\uD558\uB824\uBA74 Chroma\uB97C \uD0ED\uD558\uC5EC
      \uC120\uD0DD\uD558\uC138\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 10487182151680
    m_Localized: "Chroma\uB97C \uC120\uD0DD\uD55C \uC0C1\uD0DC\uC5D0\uC11C ChromaSphere\uB97C
      \uD68C\uC804\uC2DC\uD0A4\uBA74 \uC120\uC774 \uADF8\uB824\uC9D1\uB2C8\uB2E4.\n\n\uB450
      \uAC1C\uC758 Chroma\uB97C \uC5F0\uACB0\uD558\uC138\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 13148308656128
    m_Localized: "\uBCBD\uACFC \uB2E4\uB978 \uC0C9\uC0C1\uC740 \uACBD\uB85C\uB97C
      \uCC28\uB2E8\uD569\uB2C8\uB2E4.\n\n(\uD0ED\uD558\uC5EC \uACC4\uC18D \uC9C4\uD589)"
    m_Metadata:
      m_Items: []
  - m_Id: 9997376521785344
    m_Localized: "\uB9C9\uD788\uBA74 \uD78C\uD2B8 \uBC84\uD2BC\uC744 \uB20C\uB7EC
      \uC0C9\uC0C1\uC744 \uC790\uB3D9\uC73C\uB85C \uD574\uACB0\uD558\uC138\uC694!\n\n(\uD0ED\uD558\uC5EC
      \uACC4\uC18D \uC9C4\uD589)"
    m_Metadata:
      m_Items: []
  - m_Id: 9997419748282368
    m_Localized: "\uD78C\uD2B8\uAC00 \uB2E4 \uB5A8\uC5B4\uC9C0\uBA74 \uC0C1\uC810\uC73C\uB85C
      \uAC00\uC138\uC694.\n\n(\uD0ED\uD558\uC5EC \uACC4\uC18D \uC9C4\uD589)"
    m_Metadata:
      m_Items: []
  - m_Id: 13943146041344
    m_Localized: "\uC774 \uC0C9\uC0C1 \uC911 \uD558\uB098\uAC00 \uB2E4\uB978 \uC0C9\uC0C1\uC744
      \uC644\uC804\uD788 \uCC28\uB2E8\uD569\uB2C8\uB2E4. \uC774\uB97C \uC218\uC815\uD558\uB824\uBA74
      \uD574\uB2F9 Chroma\uB97C \uD0ED\uD558\uAC70\uB098 \uC120\uC744 \uD0ED\uD558\uC138\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 13978390777856
    m_Localized: "\uBCBD \uC548\uC758 \uC0AC\uC6A9 \uAC00\uB2A5\uD55C \uACF5\uAC04\uC744
      \uC774\uC6A9\uD558\uC5EC \uB450 \uC0C9\uC0C1\uC744 \uC5F0\uACB0\uD558\uC138\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 18077219835904
    m_Localized: "\uC0C9\uAE54\uB85C \uD14C\uB450\uB9AC\uB41C \uC601\uC5ED\uC740
      \uC6E8\uC774\uD3EC\uC778\uD2B8\uC785\uB2C8\uB2E4.\n\n\uBAA8\uB4E0 \uC6E8\uC774\uD3EC\uC778\uD2B8\uB294
      \uAC19\uC740 \uC0C9\uC0C1\uC758 \uC120\uC774 \uD1B5\uACFC\uD574\uC57C \uD569\uB2C8\uB2E4.\n\n(\uD0ED\uD558\uC5EC
      \uACC4\uC18D \uC9C4\uD589)"
    m_Metadata:
      m_Items: []
  - m_Id: 18134677606400
    m_Localized: "\uC624\uB978\uCABD \uC0C1\uB2E8\uC5D0\uB294 \uC6E8\uC774\uD3EC\uC778\uD2B8\uAC00
      \uC788\uB294 \uC0C9\uC0C1\uACFC \uC5F0\uACB0\uB41C \uC0C9\uC0C1\uC774 \uD45C\uC2DC\uB429\uB2C8\uB2E4.\n\n(\uD0ED\uD558\uC5EC
      \uACC4\uC18D \uC9C4\uD589)"
    m_Metadata:
      m_Items: []
  - m_Id: 18170949947392
    m_Localized: "\uB9C8\uC9C0\uB9C9 \uD589\uB3D9\uC744 \uB418\uB3CC\uB9AC\uB824\uBA74
      \uCDE8\uC18C \uBC84\uD2BC\uC744 \uC0AC\uC6A9\uD558\uC138\uC694.\n\n(\uD0ED\uD558\uC5EC
      \uACC4\uC18D \uC9C4\uD589)"
    m_Metadata:
      m_Items: []
  - m_Id: 18192487698432
    m_Localized: "\uB9AC\uC14B \uBC84\uD2BC\uC744 \uC0AC\uC6A9\uD558\uC5EC \uC804\uCCB4
      ChromaSphere\uB97C \uC6D0\uB798 \uC0C1\uD0DC\uB85C \uB418\uB3CC\uB9AC\uC138\uC694.\n\n(\uD0ED\uD558\uC5EC
      \uACC4\uC18D \uC9C4\uD589)"
    m_Metadata:
      m_Items: []
  - m_Id: 18219264135168
    m_Localized: "\uC798\uBABB\uB41C \uC120\uC744 \uC9C0\uC6B0\uB824\uBA74 \uCDE8\uC18C
      \uBC84\uD2BC\uC774\uB098 \uB9AC\uC14B \uBC84\uD2BC\uC744 \uC0AC\uC6A9\uD558\uC138\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 18247978340352
    m_Localized: "\uC774\uC81C Chroma\uB97C \uC120\uD0DD\uD558\uACE0 \uC6E8\uC774\uD3EC\uC778\uD2B8
      \uC601\uC5ED\uC744 \uD1B5\uACFC\uD558\uB294 \uC120\uC744 \uADF8\uB9AC\uC138\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 18281008484352
    m_Localized: "\uC6E8\uC774\uD3EC\uC778\uD2B8\uB97C \uD1B5\uACFC\uD55C \uC120\uC744
      \uB2E4\uB978 Chroma\uC640 \uC5F0\uACB0\uD558\uC138\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 23355290046464
    m_Localized: "\uD130\uB110\uC740 \uC120\uC774 ChromaSphere\uB97C \uD1B5\uACFC\uD558\uC5EC
      \uB2E4\uB978 \uBD80\uBD84\uC73C\uB85C \uAC08 \uC218 \uC788\uAC8C \uD569\uB2C8\uB2E4.\n\n(\uD0ED\uD558\uC5EC
      \uACC4\uC18D \uC9C4\uD589)"
    m_Metadata:
      m_Items: []
  - m_Id: 23402526298112
    m_Localized: "\uBCBD\uC740 \uD45C\uBA74\uC5D0\uC11C \uC774 Chroma\uB4E4 \uC0AC\uC774\uC758
      \uACBD\uB85C\uB97C \uC644\uC804\uD788 \uCC28\uB2E8\uD569\uB2C8\uB2E4. \uD130\uB110
      \uC785\uAD6C \uC911 \uD558\uB098\uB85C \uC120\uC744 \uADF8\uB9AC\uC138\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 23441927589888
    m_Localized: "\uC774\uC81C \uC120\uC744 \uB2E4\uB978 Chroma\uC640 \uC5F0\uACB0\uD558\uC138\uC694."
