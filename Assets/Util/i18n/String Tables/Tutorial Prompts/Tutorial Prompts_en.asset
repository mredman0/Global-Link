  m_TableData:
  - m_Id: 440582557696
    m_Localized: 'Welcome to The ChromaSphere.


      (Tap to continue)'
    m_Metadata:
      m_Items: []
  - m_Id: 7603900141568
    m_Localized: 'You can change settings here, including inverted controls and accessibility
      options.


      (Tap to continue)'
    m_Metadata:
      m_Items: []
  - m_Id: 8543478763520
    m_Localized: Drag along the screen to rotate The ChromaSphere.
    m_Metadata:
      m_Items: []
  - m_Id: 9257491910656
    m_Localized: 'The small Red Balls are Chromas. They must be connected to other
      Chromas of the same color.


      To start, select a Chroma by tapping it.'
    m_Metadata:
      m_Items: []
  - m_Id: 10487182151680
    m_Localized: 'While you have a Chroma selected, rotating The ChromaSphere will
      draw a line.


      Connect the two Chromas.'
    m_Metadata:
      m_Items: []
