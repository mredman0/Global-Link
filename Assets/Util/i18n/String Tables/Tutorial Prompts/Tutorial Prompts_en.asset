  m_Script: {fileID: 11500000, guid: e9620f8c34305754d8cc9a7e49e852d9, type: 3}
  m_Name: Tutorial Prompts_en
  m_EditorClassIdentifier: 
  m_LocaleId:
    m_Code: en
  m_SharedData: {fileID: 11400000, guid: 6b586f43c96c0614982e5d354f1e02dd, type: 2}
  m_Metadata:
    m_Items: []
  m_TableData:
  - m_Id: 440582557696
    m_Localized: 'Welcome to The ChromaSphere.


      (Tap to continue)'
    m_Metadata:
      m_Items: []
  - m_Id: 7603900141568
    m_Localized: 'You can change settings here, including inverted controls and accessibility
      options.


      (Tap to continue)'
    m_Metadata:
      m_Items: []
  - m_Id: 8543478763520
    m_Localized: Drag along the screen to rotate The ChromaSphere.
    m_Metadata:
      m_Items: []
  - m_Id: 9257491910656
    m_Localized: 'The small Red Balls are Chromas. They must be connected to other
      Chromas of the same color.


      To start, select a Chroma by tapping it.'
    m_Metadata:
      m_Items: []
  - m_Id: 10487182151680
    m_Localized: 'While you have a Chroma selected, rotating The ChromaSphere will
      draw a line.


      Connect the two Chromas.'
    m_Metadata:
      m_Items: []
  - m_Id: 13148308656128
    m_Localized: 'Walls and other colors will block the path.


      (Tap to continue)'
    m_Metadata:
      m_Items: []
  - m_Id: 13943146041344
    m_Localized: One of these colors completely blocks the other. To modify it, tap
      one of those Chromas OR tap the line.
    m_Metadata:
      m_Items: []
  - m_Id: 13978390777856
    m_Localized: Use the available space within the walls to connect both colors.
    m_Metadata:
      m_Items: []
  - m_Id: 18077219835904
    m_Localized: 'Colorful outlined regions are Waypoints.


      All Waypoints
      must have the line of the same color pass though them.


      (Tap to continue)'
    m_Metadata:
      m_Items: []
  - m_Id: 18134677606400
    m_Localized: 'The top right shows which colors have Waypoints and which are connected.


      (Tap
      to continue)'
    m_Metadata:
      m_Items: []
  - m_Id: 18170949947392
    m_Localized: 'Use the Undo button to revert the last action.


      (Tap to
      continue)'
    m_Metadata:
      m_Items: []
  - m_Id: 18192487698432
    m_Localized: 'Use the Reset button to reset the entire ChromaSphere to its original
      state.


      (Tap to continue)'
    m_Metadata:
      m_Items: []
  - m_Id: 18219264135168
    m_Localized: Use the Undo or Reset button to erase the incorrect line.
    m_Metadata:
      m_Items: []
  - m_Id: 18247978340352
    m_Localized: Now select a Chroma and draw a line that goes through the Waypoint
      area.
    m_Metadata:
      m_Items: []
  - m_Id: 18281008484352
    m_Localized: With the line going through the Waypoint, connect the line to the
      other Chroma.
    m_Metadata:
      m_Items: []
  - m_Id: 23355290046464
    m_Localized: 'Tunnels allow lines to cut through The ChromaSphere to get to another
      part of the surface.


      (Tap to continue)'
    m_Metadata:
      m_Items: []
  - m_Id: 23402526298112
    m_Localized: The Walls completely block the path between these Chromas on the
      surface. Draw a line to one of the Tunnel entrances.
    m_Metadata:
      m_Items: []
  - m_Id: 23441927589888
    m_Localized: Now connect the line to the other Chroma.
    m_Metadata:
      m_Items: []
  - m_Id: 9997376521785344
    m_Localized: 'If you ever get stuck, tap the Hint Button to solve a color automatically!


      (Tap
      to continue)'
    m_Metadata:
      m_Items: []
  - m_Id: 9997419748282368
    m_Localized: 'If you run out of Hints, you can watch an Ad for one more, or head
      to the Store.


      (Tap to continue)'
    m_Metadata:
      m_Items: []
  references:
    version: 2
    RefIds: []
