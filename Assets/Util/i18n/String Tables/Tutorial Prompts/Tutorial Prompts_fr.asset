  m_Name: Tutorial Prompts_fr
  m_EditorClassIdentifier: 
  m_LocaleId:
    m_Code: fr
  m_SharedData: {fileID: 11400000, guid: 6b586f43c96c0614982e5d354f1e02dd, type: 2}
  m_Metadata:
    m_Items: []
  m_TableData:
  - m_Id: 440582557696
    m_Localized: 'Bienvenue dans Le ChromaSphere.

      

      (Appuyez pour
      continuer)'
    m_Metadata:
      m_Items: []
  - m_Id: 7603900141568
    m_Localized: "Vous pouvez modifier les param\xE8tres ici, y compris les contr\xF4les
      invers\xE9s et les options d'accessibilit\xE9.\n\r\n(Appuyez pour continuer)"
    m_Metadata:
      m_Items: []
  - m_Id: 8543478763520
    m_Localized: "Faites glisser sur l'\xE9cran pour faire tourner Le ChromaSphere."
    m_Metadata:
      m_Items: []
  - m_Id: 9257491910656
    m_Localized: "Les petites boules rouges sont des Chromas. Elles doivent \xEAtre
      connect\xE9es \xE0 d'autres Chromas de la m\xEAme couleur.\r\n\r\nPour commencer,
      s\xE9lectionnez un Chroma en appuyant dessus."
    m_Metadata:
      m_Items: []
  - m_Id: 10487182151680
    m_Localized: "Tant que vous avez un Chroma s\xE9lectionn\xE9, faire tourner Le
      ChromaSphere tracera une ligne.\r\n\r\nConnectez les deux Chromas."
    m_Metadata:
      m_Items: []
  - m_Id: 13148308656128
    m_Localized: 'Les murs et les autres couleurs bloqueront le chemin.

      

      (Appuyez
      pour continuer)'
    m_Metadata:
      m_Items: []
  - m_Id: 13943146041344
    m_Localized: "L'une de ces couleurs bloque compl\xE8tement l'autre. Pour la modifier,
      appuyez sur l'un de ces Chromas OU sur la ligne."
    m_Metadata:
      m_Items: []
  - m_Id: 13978390777856
    m_Localized: "Utilisez l\u2019espace disponible \xE0 l\u2019int\xE9rieur des
      murs pour connecter les deux couleurs."
    m_Metadata:
      m_Items: []
  - m_Id: 18077219835904
    m_Localized: "Les zones color\xE9es avec des contours sont des Points de Passage.\r\n\r\nTous
      les Points de Passage doivent \xEAtre travers\xE9s par une ligne de la m\xEAme
      couleur.\n\r\n(Appuyez pour continuer)"
    m_Metadata:
      m_Items: []
  - m_Id: 18134677606400
    m_Localized: "En haut \xE0 droite, vous pouvez voir quelles couleurs ont des
      Points de Passage et lesquelles sont connect\xE9es.\n\r\n(Appuyez pour continuer)"
    m_Metadata:
      m_Items: []
  - m_Id: 18170949947392
    m_Localized: "Utilisez le bouton Annuler pour revenir \xE0 la derni\xE8re action.\n\r\n(Appuyez
      pour continuer)"
    m_Metadata:
      m_Items: []
  - m_Id: 18192487698432
    m_Localized: "Utilisez le bouton R\xE9initialiser pour r\xE9tablir toute la ChromaSphere
      \xE0 son \xE9tat initial.\n\r\n(Appuyez pour continuer)"
    m_Metadata:
      m_Items: []
  - m_Id: 18219264135168
    m_Localized: "Utilisez le bouton Annuler ou R\xE9initialiser pour effacer la
      ligne incorrecte."
    m_Metadata:
      m_Items: []
  - m_Id: 18247978340352
    m_Localized: "Maintenant, s\xE9lectionnez un Chroma et tracez une ligne qui traverse
      la zone du Point de Passage."
    m_Metadata:
      m_Items: []
  - m_Id: 18281008484352
    m_Localized: "Avec la ligne passant par le Point de Passage, connectez la ligne
      \xE0 l\u2019autre Chroma."
    m_Metadata:
      m_Items: []
  references:
    version: 2
    RefIds: []
