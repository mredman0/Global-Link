  m_TableData:
  - m_Id: 440582557696
    m_Localized: 'Bienvenue dans Le ChromaSphere.

      

      (Appuyez pour
      continuer)'
    m_Metadata:
      m_Items: []
  - m_Id: 7603900141568
    m_Localized: "Vous pouvez modifier les param\xE8tres ici, y compris les contr\xF4les
      invers\xE9s et les options d'accessibilit\xE9.\n\r\n(Appuyez pour continuer)"
    m_Metadata:
      m_Items: []
  - m_Id: 8543478763520
    m_Localized: "Faites glisser sur l'\xE9cran pour faire tourner Le ChromaSphere."
    m_Metadata:
      m_Items: []
  - m_Id: 9257491910656
    m_Localized: "Les petites boules rouges sont des Chromas. Elles doivent \xEAtre
      connect\xE9es \xE0 d'autres Chromas de la m\xEAme couleur.\r\n\r\nPour commencer,
      s\xE9lectionnez un Chroma en appuyant dessus."
    m_Metadata:
      m_Items: []
  - m_Id: 10487182151680
    m_Localized: "Tant que vous avez un Chroma s\xE9lectionn\xE9, faire tourner Le
      ChromaSphere tracera une ligne.\r\n\r\nConnectez les deux Chromas."
    m_Metadata:
      m_Items: []
