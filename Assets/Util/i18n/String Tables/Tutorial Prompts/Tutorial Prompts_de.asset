  m_Script: {fileID: 11500000, guid: e9620f8c34305754d8cc9a7e49e852d9, type: 3}
  m_Name: Tutorial Prompts_de
  m_EditorClassIdentifier: 
  m_LocaleId:
    m_Code: de
  m_SharedData: {fileID: 11400000, guid: 6b586f43c96c0614982e5d354f1e02dd, type: 2}
  m_Metadata:
    m_Items: []
  m_TableData:
  - m_Id: 440582557696
    m_Localized: 'Willkommen bei Der ChromaSphere.


      (Tippen, um fortzufahren)'
    m_Metadata:
      m_Items: []
  - m_Id: 7603900141568
    m_Localized: "Du kannst hier die Einstellungen \xE4ndern, einschlie\xDFlich invertierter
      Steuerung und Barrierefreiheitsoptionen.\n\r\n(Tippen, um fortzufahren)"
    m_Metadata:
      m_Items: []
  - m_Id: 8543478763520
    m_Localized: "Ziehe \xFCber den Bildschirm, um Die ChromaSphere zu drehen."
    m_Metadata:
      m_Items: []
  - m_Id: 9257491910656
    m_Localized: "Die kleinen roten B\xE4lle sind Chromas. Sie m\xFCssen mit anderen
      Chromas derselben Farbe verbunden werden.\r\n\r\nUm zu beginnen, w\xE4hle ein
      Chroma aus, indem du darauf tippst."
    m_Metadata:
      m_Items: []
  - m_Id: 10487182151680
    m_Localized: "W\xE4hrend du ein Chroma ausgew\xE4hlt hast, wird das Drehen der
      ChromaSphere eine Linie zeichnen.\r\n\r\nVerbinde die beiden Chromas."
    m_Metadata:
      m_Items: []
  - m_Id: 13148308656128
    m_Localized: "W\xE4nde und andere Farben blockieren den Weg.\n\r\n(Tippen, um
      fortzufahren)"
    m_Metadata:
      m_Items: []
  - m_Id: 13943146041344
    m_Localized: "Eine dieser Farben blockiert die andere vollst\xE4ndig. Um sie
      zu \xE4ndern, tippe auf eines der Chromas ODER auf die Linie."
    m_Metadata:
      m_Items: []
  - m_Id: 13978390777856
    m_Localized: "Nutze den verf\xFCgbaren Raum innerhalb der W\xE4nde, um beide
      Farben zu verbinden."
    m_Metadata:
      m_Items: []
  - m_Id: 18077219835904
    m_Localized: "Farbige umrissene Bereiche sind Wegpunkte.\r\n\r\nAlle Wegpunkte
      m\xFCssen von einer Linie derselben Farbe durchquert werden.\n\r\n(Tippen,
      um fortzufahren)"
    m_Metadata:
      m_Items: []
  - m_Id: 18134677606400
    m_Localized: 'Oben rechts wird angezeigt, welche Farben Wegpunkte haben und welche
      verbunden sind.


      (Tippen, um fortzufahren)'
    m_Metadata:
      m_Items: []
  - m_Id: 18170949947392
    m_Localized: "Verwende die R\xFCckg\xE4ngig-Taste, um die letzte Aktion r\xFCckg\xE4ngig
      zu machen.\n\r\n(Tippen, um fortzufahren)"
    m_Metadata:
      m_Items: []
  - m_Id: 18192487698432
    m_Localized: "Verwende die Zur\xFCcksetzen-Taste, um die gesamte ChromaSphere
      in ihren urspr\xFCnglichen Zustand zur\xFCckzusetzen.\n\r\n(Tippen, um fortzufahren)"
    m_Metadata:
      m_Items: []
  - m_Id: 18219264135168
    m_Localized: "Verwende die R\xFCckg\xE4ngig- oder Zur\xFCcksetzen-Taste, um die
      falsche Linie zu l\xF6schen."
    m_Metadata:
      m_Items: []
  - m_Id: 18247978340352
    m_Localized: "W\xE4hle nun ein Chroma aus und ziehe eine Linie, die durch den
      Bereich des Wegpunkts verl\xE4uft."
    m_Metadata:
      m_Items: []
  - m_Id: 18281008484352
    m_Localized: "Mit der Linie, die durch den Wegpunkt verl\xE4uft, verbinde die
      Linie mit dem anderen Chroma."
    m_Metadata:
      m_Items: []
  - m_Id: 23355290046464
    m_Localized: "Tunnel erm\xF6glichen es Linien, die ChromaSphere zu durchqueren,
      um zu einem anderen Teil der Oberfl\xE4che zu gelangen.\n\r\n(Tippen, um fortzufahren)"
    m_Metadata:
      m_Items: []
  - m_Id: 23402526298112
    m_Localized: "Die W\xE4nde blockieren vollst\xE4ndig den Weg zwischen diesen
      Chromas auf der Oberfl\xE4che. Ziehe eine Linie zu einem der Tunnel-Eing\xE4nge."
    m_Metadata:
      m_Items: []
  - m_Id: 23441927589888
    m_Localized: Verbinde nun die Linie mit dem anderen Chroma.
    m_Metadata:
      m_Items: []
  - m_Id: 9997376521785344
    m_Localized: "Wenn du feststeckst, tippe auf den Hinweis-Button, um eine Farbe
      automatisch zu l\xF6sen!\n\r\n(Tippen, um fortzufahren)"
    m_Metadata:
      m_Items: []
  - m_Id: 9997419748282368
    m_Localized: 'Wenn dir die Hinweise ausgehen, kannst du eine Werbung anschauen,
      um einen weiteren zu erhalten, oder zum Shop gehen.


      (Tippen, um fortzufahren)'
    m_Metadata:
      m_Items: []
  references:
    version: 2
    RefIds: []
