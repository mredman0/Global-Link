  m_TableData:
  - m_Id: 440582557696
    m_Localized: 'Benvenuto in Il ChromaSphere.

      

      (Tocca per continuare)'
    m_Metadata:
      m_Items: []
  - m_Id: 7603900141568
    m_Localized: "Puoi modificare le impostazioni qui, inclusi i controlli invertiti
      e le opzioni di accessibilit\xE0.\n\r\n(Tocca per continuare)"
    m_Metadata:
      m_Items: []
  - m_Id: 8543478763520
    m_Localized: Trascina sullo schermo per ruotare Il ChromaSphere.
    m_Metadata:
      m_Items: []
  - m_Id: 9257491910656
    m_Localized: 'Le piccole sfere rosse sono i Chromas. Devono essere connesse ad
      altri Chromas dello stesso colore.

      

      Per cominciare, seleziona
      un Chroma toccandolo.'
    m_Metadata:
      m_Items: []
  - m_Id: 10487182151680
    m_Localized: "Mentre hai un Chroma selezionato, ruotare Il ChromaSphere disegner\xE0
      una linea.\r\n\r\nCollega i due Chromas."
    m_Metadata:
      m_Items: []
