  m_Script: {fileID: 11500000, guid: e9620f8c34305754d8cc9a7e49e852d9, type: 3}
  m_Name: Tutorial Prompts_it
  m_EditorClassIdentifier: 
  m_LocaleId:
    m_Code: it
  m_SharedData: {fileID: 11400000, guid: 6b586f43c96c0614982e5d354f1e02dd, type: 2}
  m_Metadata:
    m_Items: []
  m_TableData:
  - m_Id: 440582557696
    m_Localized: 'Benvenuto in Il ChromaSphere.


      (Tocca per continuare)'
    m_Metadata:
      m_Items: []
  - m_Id: 7603900141568
    m_Localized: "Puoi modificare le impostazioni qui, inclusi i controlli invertiti
      e le opzioni di accessibilit\xE0.\n\r\n(Tocca per continuare)"
    m_Metadata:
      m_Items: []
  - m_Id: 8543478763520
    m_Localized: Trascina sullo schermo per ruotare Il ChromaSphere.
    m_Metadata:
      m_Items: []
  - m_Id: 9257491910656
    m_Localized: 'Le piccole sfere rosse sono i Chromas. Devono essere connesse ad
      altri Chromas dello stesso colore.


      Per cominciare, seleziona un Chroma
      toccandolo.'
    m_Metadata:
      m_Items: []
  - m_Id: 10487182151680
    m_Localized: "Mentre hai un Chroma selezionato, ruotare Il ChromaSphere disegner\xE0
      una linea.\r\n\r\nCollega i due Chromas."
    m_Metadata:
      m_Items: []
  - m_Id: 13148308656128
    m_Localized: 'I muri e gli altri colori bloccheranno il percorso.


      (Tocca
      per continuare)'
    m_Metadata:
      m_Items: []
  - m_Id: 13943146041344
    m_Localized: Uno di questi colori blocca completamente l'altro. Per modificarlo,
      tocca uno di quei Chromas O la linea.
    m_Metadata:
      m_Items: []
  - m_Id: 13978390777856
    m_Localized: Usa lo spazio disponibile all'interno dei muri per collegare entrambi
      i colori.
    m_Metadata:
      m_Items: []
  - m_Id: 18077219835904
    m_Localized: 'Le regioni colorate con contorni sono Punti di Controllo.


      Tutti
      i Punti di Controllo devono essere attraversati da una linea dello stesso colore.


      (Tocca
      per continuare)'
    m_Metadata:
      m_Items: []
  - m_Id: 18134677606400
    m_Localized: 'In alto a destra viene mostrato quali colori hanno Punti di Controllo
      e quali sono collegati.


      (Tocca per continuare)'
    m_Metadata:
      m_Items: []
  - m_Id: 18170949947392
    m_Localized: 'Usa il pulsante Annulla per annullare l''ultima azione.


      (Tocca
      per continuare)'
    m_Metadata:
      m_Items: []
  - m_Id: 18192487698432
    m_Localized: 'Usa il pulsante Ripristina per riportare l''intera ChromaSphere
      al suo stato originale.


      (Tocca per continuare)'
    m_Metadata:
      m_Items: []
  - m_Id: 18219264135168
    m_Localized: Usa il pulsante Annulla o Ripristina per cancellare la linea errata.
    m_Metadata:
      m_Items: []
  - m_Id: 18247978340352
    m_Localized: Ora seleziona un Chroma e traccia una linea che attraversi l'area
      del Punto di Controllo.
    m_Metadata:
      m_Items: []
  - m_Id: 18281008484352
    m_Localized: "Con la linea che attraversa il Punto di Controllo, collega la linea
      all\u2019altro Chroma."
    m_Metadata:
      m_Items: []
  - m_Id: 23355290046464
    m_Localized: 'I tunnel permettono alle linee di attraversare la ChromaSphere
      per raggiungere un''altra parte della superficie.



      (Tocca per continuare)'
    m_Metadata:
      m_Items: []
  - m_Id: 23402526298112
    m_Localized: Le Mura bloccano completamente il percorso tra questi Chromas sulla
      superficie. Traccia una linea verso una delle entrate del tunnel.
    m_Metadata:
      m_Items: []
  - m_Id: 23441927589888
    m_Localized: "Ora collega la linea all\u2019altro Chroma."
    m_Metadata:
      m_Items: []
  - m_Id: 9997376521785344
    m_Localized: 'Se rimani bloccato, tocca il pulsante Suggerimento per risolvere
      automaticamente un colore!


      (Tocca per continuare)'
    m_Metadata:
      m_Items: []
  - m_Id: 9997419748282368
    m_Localized: 'Se finisci i suggerimenti, puoi andare al negozio.


      (Tocca per continuare)'
    m_Metadata:
      m_Items: []
  references:
    version: 2
    RefIds: []
