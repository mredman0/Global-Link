  m_TableData:
  - m_Id: 440582557696
    m_Localized: "\u0414\u043E\u0431\u0440\u043E \u043F\u043E\u0436\u0430\u043B\u043E\u0432\u0430\u0442\u044C
      \u0432 ChromaSphere.\n\n(\u041D\u0430\u0436\u043C\u0438\u0442\u0435, \u0447\u0442\u043E\u0431\u044B
      \u043F\u0440\u043E\u0434\u043E\u043B\u0436\u0438\u0442\u044C)"
    m_Metadata:
      m_Items: []
  - m_Id: 7603900141568
    m_Localized: "\u0412\u044B \u043C\u043E\u0436\u0435\u0442\u0435 \u0438\u0437\u043C\u0435\u043D\u0438\u0442\u044C
      \u043D\u0430\u0441\u0442\u0440\u043E\u0439\u043A\u0438 \u0437\u0434\u0435\u0441\u044C,
      \u0432\u043A\u043B\u044E\u0447\u0430\u044F \u0438\u043D\u0432\u0435\u0440\u0442\u0438\u0440\u043E\u0432\u0430\u043D\u043D\u044B\u0435
      \u044D\u043B\u0435\u043C\u0435\u043D\u0442\u044B \u0443\u043F\u0440\u0430\u0432\u043B\u0435\u043D\u0438\u044F
      \u0438 \u043F\u0430\u0440\u0430\u043C\u0435\u0442\u0440\u044B \u0434\u043E\u0441\u0442\u0443\u043F\u043D\u043E\u0441\u0442\u0438.\n\n(\u041D\u0430\u0436\u043C\u0438\u0442\u0435,
      \u0447\u0442\u043E\u0431\u044B \u043F\u0440\u043E\u0434\u043E\u043B\u0436\u0438\u0442\u044C)"
    m_Metadata:
      m_Items: []
  - m_Id: 8543478763520
    m_Localized: "\u041F\u0435\u0440\u0435\u0442\u0430\u0449\u0438\u0442\u0435 \u043F\u043E
      \u044D\u043A\u0440\u0430\u043D\u0443, \u0447\u0442\u043E\u0431\u044B \u043F\u043E\u0432\u0435\u0440\u043D\u0443\u0442\u044C
      \u0425\u0440\u043E\u043C\u0430\u0421\u0444\u0435\u0440\u0443."
    m_Metadata:
      m_Items: []
  - m_Id: 9257491910656
    m_Localized: "\u041C\u0430\u043B\u0435\u043D\u044C\u043A\u0438\u0435 \u043A\u0440\u0430\u0441\u043D\u044B\u0435
      \u0448\u0430\u0440\u044B \u2014 \u044D\u0442\u043E Chromas. \u0418\u0445 \u043D\u0443\u0436\u043D\u043E
      \u0441\u043E\u0435\u0434\u0438\u043D\u044F\u0442\u044C \u0441 \u0434\u0440\u0443\u0433\u0438\u043C\u0438
      Chromas \u0442\u043E\u0433\u043E \u0436\u0435 \u0446\u0432\u0435\u0442\u0430.\n\n\u0414\u043B\u044F
      \u043D\u0430\u0447\u0430\u043B\u0430 \u0432\u044B\u0431\u0435\u0440\u0438\u0442\u0435
      Chroma, \u043A\u043E\u0441\u043D\u0443\u0432\u0448\u0438\u0441\u044C \u0435\u0433\u043E."
    m_Metadata:
      m_Items: []
  - m_Id: 10487182151680
    m_Localized: "\u041F\u043E\u043A\u0430 \u0443 \u0432\u0430\u0441 \u0432\u044B\u0431\u0440\u0430\u043D
      Chroma, \u0432\u0440\u0430\u0449\u0435\u043D\u0438\u0435 ChromaSphere \u043D\u0430\u0440\u0438\u0441\u0443\u0435\u0442
      \u043B\u0438\u043D\u0438\u044E.\n\n\u0421\u043E\u0435\u0434\u0438\u043D\u0438\u0442\u0435
      \u0434\u0432\u0430 Chroma."
    m_Metadata:
      m_Items: []
  - m_Id: 13148308656128
    m_Localized: "\u0421\u0442\u0435\u043D\u044B \u0438 \u0434\u0440\u0443\u0433\u0438\u0435
      \u0446\u0432\u0435\u0442\u0430 \u0437\u0430\u0431\u043B\u043E\u043A\u0438\u0440\u0443\u044E\u0442
      \u043F\u0443\u0442\u044C.\n\n(\u041D\u0430\u0436\u043C\u0438\u0442\u0435, \u0447\u0442\u043E\u0431\u044B
      \u043F\u0440\u043E\u0434\u043E\u043B\u0436\u0438\u0442\u044C)"
    m_Metadata:
      m_Items: []
  - m_Id: 9997376521785344
    m_Localized: "\u0415\u0441\u043B\u0438 \u0432\u044B \u0437\u0430\u0441\u0442\u0440\u044F\u043B\u0438,
      \u043D\u0430\u0436\u043C\u0438\u0442\u0435 \u043A\u043D\u043E\u043F\u043A\u0443
      \u043F\u043E\u0434\u0441\u043A\u0430\u0437\u043A\u0438, \u0447\u0442\u043E\u0431\u044B
      \u0430\u0432\u0442\u043E\u043C\u0430\u0442\u0438\u0447\u0435\u0441\u043A\u0438
      \u0440\u0435\u0448\u0438\u0442\u044C \u0446\u0432\u0435\u0442!\n\n(\u041D\u0430\u0436\u043C\u0438\u0442\u0435,
      \u0447\u0442\u043E\u0431\u044B \u043F\u0440\u043E\u0434\u043E\u043B\u0436\u0438\u0442\u044C)"
    m_Metadata:
      m_Items: []
  - m_Id: 9997419748282368
    m_Localized: "\u0415\u0441\u043B\u0438 \u0443 \u0432\u0430\u0441 \u0437\u0430\u043A\u043E\u043D\u0447\u0438\u043B\u0438\u0441\u044C
      \u043F\u043E\u0434\u0441\u043A\u0430\u0437\u043A\u0438, \u0432\u044B \u043C\u043E\u0436\u0435\u0442\u0435
      \u043F\u0435\u0440\u0435\u0439\u0442\u0438 \u0432 \u043C\u0430\u0433\u0430\u0437\u0438\u043D.\n\n(\u041D\u0430\u0436\u043C\u0438\u0442\u0435,
      \u0447\u0442\u043E\u0431\u044B \u043F\u0440\u043E\u0434\u043E\u043B\u0436\u0438\u0442\u044C)"
    m_Metadata:
      m_Items: []
  - m_Id: 13943146041344
    m_Localized: "\u041E\u0434\u0438\u043D \u0438\u0437 \u044D\u0442\u0438\u0445
      \u0446\u0432\u0435\u0442\u043E\u0432 \u043F\u043E\u043B\u043D\u043E\u0441\u0442\u044C\u044E
      \u0431\u043B\u043E\u043A\u0438\u0440\u0443\u0435\u0442 \u0434\u0440\u0443\u0433\u043E\u0439.
      \u0427\u0442\u043E\u0431\u044B \u0438\u0437\u043C\u0435\u043D\u0438\u0442\u044C
      \u044D\u0442\u043E, \u043A\u043E\u0441\u043D\u0438\u0442\u0435\u0441\u044C
      \u043E\u0434\u043D\u043E\u0433\u043E \u0438\u0437 \u044D\u0442\u0438\u0445
      Chroma \u0438\u043B\u0438 \u043A\u043E\u0441\u043D\u0438\u0442\u0435\u0441\u044C
      \u043B\u0438\u043D\u0438\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 13978390777856
    m_Localized: "\u0418\u0441\u043F\u043E\u043B\u044C\u0437\u0443\u0439\u0442\u0435
      \u0434\u043E\u0441\u0442\u0443\u043F\u043D\u043E\u0435 \u043F\u0440\u043E\u0441\u0442\u0440\u0430\u043D\u0441\u0442\u0432\u043E
      \u0432\u043D\u0443\u0442\u0440\u0438 \u0441\u0442\u0435\u043D, \u0447\u0442\u043E\u0431\u044B
      \u0441\u043E\u0435\u0434\u0438\u043D\u0438\u0442\u044C \u043E\u0431\u0430 \u0446\u0432\u0435\u0442\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 18077219835904
    m_Localized: "\u041E\u043A\u0440\u0443\u0436\u0451\u043D\u043D\u044B\u0435 \u0446\u0432\u0435\u0442\u043D\u043E\u0439
      \u0440\u0430\u043C\u043A\u043E\u0439 \u043E\u0431\u043B\u0430\u0441\u0442\u0438
      \u2014 \u044D\u0442\u043E \u043A\u043E\u043D\u0442\u0440\u043E\u043B\u044C\u043D\u044B\u0435
      \u0442\u043E\u0447\u043A\u0438.\n\n\u0412\u0441\u0435 \u043A\u043E\u043D\u0442\u0440\u043E\u043B\u044C\u043D\u044B\u0435
      \u0442\u043E\u0447\u043A\u0438 \u0434\u043E\u043B\u0436\u043D\u044B \u0431\u044B\u0442\u044C
      \u043F\u0435\u0440\u0435\u0441\u0435\u0447\u0435\u043D\u044B \u043B\u0438\u043D\u0438\u0435\u0439
      \u0442\u043E\u0433\u043E \u0436\u0435 \u0446\u0432\u0435\u0442\u0430.\n\n(\u041D\u0430\u0436\u043C\u0438\u0442\u0435,
      \u0447\u0442\u043E\u0431\u044B \u043F\u0440\u043E\u0434\u043E\u043B\u0436\u0438\u0442\u044C)"
    m_Metadata:
      m_Items: []
  - m_Id: 18134677606400
    m_Localized: "\u0412 \u043F\u0440\u0430\u0432\u043E\u043C \u0432\u0435\u0440\u0445\u043D\u0435\u043C
      \u0443\u0433\u043B\u0443 \u043F\u043E\u043A\u0430\u0437\u0430\u043D\u043E,
      \u043A\u0430\u043A\u0438\u0435 \u0446\u0432\u0435\u0442\u0430 \u0438\u043C\u0435\u044E\u0442
      \u043A\u043E\u043D\u0442\u0440\u043E\u043B\u044C\u043D\u044B\u0435 \u0442\u043E\u0447\u043A\u0438
      \u0438 \u043A\u0430\u043A\u0438\u0435 \u0441\u043E\u0435\u0434\u0438\u043D\u0435\u043D\u044B.\n\n(\u041D\u0430\u0436\u043C\u0438\u0442\u0435,
      \u0447\u0442\u043E\u0431\u044B \u043F\u0440\u043E\u0434\u043E\u043B\u0436\u0438\u0442\u044C)"
    m_Metadata:
      m_Items: []
  - m_Id: 18170949947392
    m_Localized: "\u0418\u0441\u043F\u043E\u043B\u044C\u0437\u0443\u0439\u0442\u0435
      \u043A\u043D\u043E\u043F\u043A\u0443 \"\u041E\u0442\u043C\u0435\u043D\u0438\u0442\u044C\",
      \u0447\u0442\u043E\u0431\u044B \u0432\u0435\u0440\u043D\u0443\u0442\u044C \u043F\u043E\u0441\u043B\u0435\u0434\u043D\u0435\u0435
      \u0434\u0435\u0439\u0441\u0442\u0432\u0438\u0435.\n\n(\u041D\u0430\u0436\u043C\u0438\u0442\u0435,
      \u0447\u0442\u043E\u0431\u044B \u043F\u0440\u043E\u0434\u043E\u043B\u0436\u0438\u0442\u044C)"
    m_Metadata:
      m_Items: []
  - m_Id: 18192487698432
    m_Localized: "\u0418\u0441\u043F\u043E\u043B\u044C\u0437\u0443\u0439\u0442\u0435
      \u043A\u043D\u043E\u043F\u043A\u0443 \"\u0421\u0431\u0440\u043E\u0441\u0438\u0442\u044C\",
      \u0447\u0442\u043E\u0431\u044B \u0432\u0435\u0440\u043D\u0443\u0442\u044C \u0432\u0441\u044E
      ChromaSphere \u0432 \u0438\u0441\u0445\u043E\u0434\u043D\u043E\u0435 \u0441\u043E\u0441\u0442\u043E\u044F\u043D\u0438\u0435.\n\n(\u041D\u0430\u0436\u043C\u0438\u0442\u0435,
      \u0447\u0442\u043E\u0431\u044B \u043F\u0440\u043E\u0434\u043E\u043B\u0436\u0438\u0442\u044C)"
    m_Metadata:
      m_Items: []
  - m_Id: 18219264135168
    m_Localized: "\u0418\u0441\u043F\u043E\u043B\u044C\u0437\u0443\u0439\u0442\u0435
      \u043A\u043D\u043E\u043F\u043A\u0443 \"\u041E\u0442\u043C\u0435\u043D\u0438\u0442\u044C\"
      \u0438\u043B\u0438 \"\u0421\u0431\u0440\u043E\u0441\u0438\u0442\u044C\", \u0447\u0442\u043E\u0431\u044B
      \u0441\u0442\u0435\u0440\u0435\u0442\u044C \u043D\u0435\u043F\u0440\u0430\u0432\u0438\u043B\u044C\u043D\u0443\u044E
      \u043B\u0438\u043D\u0438\u044E."
    m_Metadata:
      m_Items: []
  - m_Id: 18247978340352
    m_Localized: "\u0422\u0435\u043F\u0435\u0440\u044C \u0432\u044B\u0431\u0435\u0440\u0438\u0442\u0435
      Chroma \u0438 \u043F\u0440\u043E\u0432\u0435\u0434\u0438\u0442\u0435 \u043B\u0438\u043D\u0438\u044E,
      \u043A\u043E\u0442\u043E\u0440\u0430\u044F \u043F\u0440\u043E\u0445\u043E\u0434\u0438\u0442
      \u0447\u0435\u0440\u0435\u0437 \u043E\u0431\u043B\u0430\u0441\u0442\u044C \u043A\u043E\u043D\u0442\u0440\u043E\u043B\u044C\u043D\u043E\u0439
      \u0442\u043E\u0447\u043A\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 18281008484352
    m_Localized: "\u041F\u0440\u043E\u0432\u0435\u0434\u0438\u0442\u0435 \u043B\u0438\u043D\u0438\u044E
      \u0447\u0435\u0440\u0435\u0437 \u043A\u043E\u043D\u0442\u0440\u043E\u043B\u044C\u043D\u0443\u044E
      \u0442\u043E\u0447\u043A\u0443 \u0438 \u0441\u043E\u0435\u0434\u0438\u043D\u0438\u0442\u0435
      \u0435\u0451 \u0441 \u0434\u0440\u0443\u0433\u0438\u043C Chroma."
    m_Metadata:
      m_Items: []
  - m_Id: 23355290046464
    m_Localized: "\u0422\u0443\u043D\u043D\u0435\u043B\u0438 \u043F\u043E\u0437\u0432\u043E\u043B\u044F\u044E\u0442
      \u043B\u0438\u043D\u0438\u044F\u043C \u043F\u0440\u043E\u0445\u043E\u0434\u0438\u0442\u044C
      \u0447\u0435\u0440\u0435\u0437 ChromaSphere, \u0447\u0442\u043E\u0431\u044B
      \u043F\u043E\u043F\u0430\u0441\u0442\u044C \u0432 \u0434\u0440\u0443\u0433\u0443\u044E
      \u0447\u0430\u0441\u0442\u044C \u043F\u043E\u0432\u0435\u0440\u0445\u043D\u043E\u0441\u0442\u0438.\n\n(\u041D\u0430\u0436\u043C\u0438\u0442\u0435,
      \u0447\u0442\u043E\u0431\u044B \u043F\u0440\u043E\u0434\u043E\u043B\u0436\u0438\u0442\u044C)"
    m_Metadata:
      m_Items: []
  - m_Id: 23402526298112
    m_Localized: "\u0421\u0442\u0435\u043D\u044B \u043F\u043E\u043B\u043D\u043E\u0441\u0442\u044C\u044E
      \u0431\u043B\u043E\u043A\u0438\u0440\u0443\u044E\u0442 \u043F\u0443\u0442\u044C
      \u043C\u0435\u0436\u0434\u0443 \u044D\u0442\u0438\u043C\u0438 Chroma \u043D\u0430
      \u043F\u043E\u0432\u0435\u0440\u0445\u043D\u043E\u0441\u0442\u0438. \u041F\u0440\u043E\u0432\u0435\u0434\u0438\u0442\u0435
      \u043B\u0438\u043D\u0438\u044E \u043A \u043E\u0434\u043D\u043E\u043C\u0443
      \u0438\u0437 \u0432\u0445\u043E\u0434\u043E\u0432 \u0432 \u0442\u0443\u043D\u043D\u0435\u043B\u044C."
    m_Metadata:
      m_Items: []
  - m_Id: 23441927589888
    m_Localized: "\u0422\u0435\u043F\u0435\u0440\u044C \u0441\u043E\u0435\u0434\u0438\u043D\u0438\u0442\u0435
      \u043B\u0438\u043D\u0438\u044E \u0441 \u0434\u0440\u0443\u0433\u0438\u043C
      Chroma."
    m_Metadata:
      m_Items: []
