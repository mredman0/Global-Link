  m_Name: Tutorial Prompts_es
  m_EditorClassIdentifier: 
  m_LocaleId:
    m_Code: es
  m_SharedData: {fileID: 11400000, guid: 6b586f43c96c0614982e5d354f1e02dd, type: 2}
  m_Metadata:
    m_Items: []
  m_TableData:
  - m_Id: 440582557696
    m_Localized: 'Bienvenido a El ChromaSphere.


      (Pulse para continuar)'
    m_Metadata:
      m_Items: []
  - m_Id: 7603900141568
    m_Localized: "Puedes cambiar la configuraci\xF3n aqu\xED, incluyendo los controles
      invertidos y las opciones de accesibilidad.\n\r\n(Pulse para continuar)"
    m_Metadata:
      m_Items: []
  - m_Id: 8543478763520
    m_Localized: Arrastra por la pantalla para rotar El ChromaSphere.
    m_Metadata:
      m_Items: []
  - m_Id: 9257491910656
    m_Localized: "Las peque\xF1as bolas rojas son Chromas. Deben conectarse con otros
      Chromas del mismo color.\r\n\r\nPara empezar, selecciona un Chroma toc\xE1ndolo."
    m_Metadata:
      m_Items: []
  - m_Id: 10487182151680
    m_Localized: "Mientras tengas un Chroma seleccionado, rotar El ChromaSphere trazar\xE1
      una l\xEDnea.\r\n\r\nConecta los dos Chromas."
    m_Metadata:
      m_Items: []
  - m_Id: 13148308656128
    m_Localized: "Las paredes y otros colores bloquear\xE1n el camino.\n\r\n(Pulse
      para continuar)"
    m_Metadata:
      m_Items: []
  - m_Id: 13943146041344
    m_Localized: "Uno de estos colores bloquea completamente al otro. Para modificarlo,
      toca uno de esos Chromas O la l\xEDnea."
    m_Metadata:
      m_Items: []
  - m_Id: 13978390777856
    m_Localized: Usa el espacio disponible dentro de las paredes para conectar ambos
      colores.
    m_Metadata:
      m_Items: []
  - m_Id: 18077219835904
    m_Localized: "Las regiones coloridas con contornos son Puntos de Control.\r\n\r\nTodos
      los Puntos de Control deben ser atravesados por una l\xEDnea del mismo color.\n\r\n(Pulse
      para continuar)"
    m_Metadata:
      m_Items: []
  - m_Id: 18134677606400
    m_Localized: "En la parte superior derecha se muestra qu\xE9 colores tienen Puntos
      de Control y cu\xE1les est\xE1n conectados.\n\r\n(Pulse para continuar)"
    m_Metadata:
      m_Items: []
  - m_Id: 18170949947392
    m_Localized: "Usa el bot\xF3n Deshacer para revertir la \xFAltima acci\xF3n.\n\r\n(Pulse
      para continuar)"
    m_Metadata:
      m_Items: []
  - m_Id: 18192487698432
    m_Localized: "Usa el bot\xF3n Restablecer para devolver toda la ChromaSphere
      a su estado original.\n\r\n(Pulse para continuar)"
    m_Metadata:
      m_Items: []
  - m_Id: 18219264135168
    m_Localized: "Usa el bot\xF3n Deshacer o Restablecer para borrar la l\xEDnea
      incorrecta."
    m_Metadata:
      m_Items: []
  - m_Id: 18247978340352
    m_Localized: "Ahora selecciona un Chroma y dibuja una l\xEDnea que pase por el
      \xE1rea del Punto de Control."
    m_Metadata:
      m_Items: []
  - m_Id: 18281008484352
    m_Localized: "Con la l\xEDnea pasando por el Punto de Control, conecta la l\xEDnea
      con el otro Chroma."
    m_Metadata:
      m_Items: []
  - m_Id: 23355290046464
    m_Localized: "Los t\xFAneles permiten que las l\xEDneas atraviesen la ChromaSphere
      para llegar a otra parte de la superficie.\n\r\n(Pulse para continuar)"
    m_Metadata:
      m_Items: []
  - m_Id: 23402526298112
    m_Localized: "Las Paredes bloquean completamente el camino entre estos Chromas
      en la superficie. Dibuja una l\xEDnea hacia una de las entradas del t\xFAnel."
    m_Metadata:
      m_Items: []
  - m_Id: 23441927589888
    m_Localized: "Ahora conecta la l\xEDnea con el otro Chroma."
    m_Metadata:
      m_Items: []
  - m_Id: 9997376521785344
    m_Localized: "Si alguna vez te atascas, toca el bot\xF3n de pista para resolver
      un color autom\xE1ticamente!\n\r\n(Pulse para continuar)"
    m_Metadata:
      m_Items: []
  - m_Id: 9997419748282368
    m_Localized: "Si te quedas sin pistas, puedes dirigirte a la tienda.\n\n(Pulse para continuar)"
    m_Metadata:
      m_Items: []
  references:
    version: 2
    RefIds: []
