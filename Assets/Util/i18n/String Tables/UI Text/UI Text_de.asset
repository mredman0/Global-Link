    m_Metadata:
      m_Items: []
  - m_Id: 12005776692629504
    m_Localized: "Mehr t\xE4gliche R\xE4tsel"
    m_Metadata:
      m_Items: []
  - m_Id: 12008259829649408
    m_Localized: ALLE
    m_Metadata:
      m_Items: []
  - m_Id: 16543813208395776
    m_Localized: "Willkommen!\r\n\nEs sieht so aus, als ob Sie neu hier sind. M\xF6chten
      Sie das Tutorial besuchen?"
    m_Metadata:
      m_Items: []
  - m_Id: 19870318709723136
    m_Localized: "Diese App verwendet die Werbe-ID Ihres Ger\xE4ts, um personalisierte
      und relevantere Anzeigen bereitzustellen."
    m_Metadata:
      m_Items: []
  - m_Id: 24236018148593664
    m_Localized: 'Serie:'
    m_Metadata:
      m_Items: []
  - m_Id: 24236030270132224
    m_Localized: 'Abgeschlossen:'
    m_Metadata:
      m_Items: []
  - m_Id: 24236072167034880
    m_Localized: "Verl\xE4ngern Sie Ihre t\xE4gliche Serie, indem Sie jeden Tag 3
      t\xE4gliche R\xE4tsel abschlie\xDFen."
    m_Metadata:
      m_Items: []
  - m_Id: 27534971216613376
    m_Localized: "K\xE4ufe wiederherstellen"
    m_Metadata:
      m_Items: []
  - m_Id: 27534710855192576
    m_Localized: "K\xE4ufe konnten nicht wiederhergestellt werden"
    m_Metadata:
      m_Items: []
  - m_Id: 27538739295440896
    m_Localized: "K\xE4ufe wiederhergestellt!"
    m_Metadata:
      m_Items: []
  - m_Id: 27553899598860288
    m_Localized: Verwaltung
    m_Metadata:
      m_Items: []
  - m_Id: 37602962650189824
    m_Localized: "Gef\xE4llt dir das Spiel?"
    m_Metadata:
      m_Items: []
  - m_Id: 37603949989351424
    m_Localized: "Ich w\xE4re geehrt, wenn du eine Bewertung oder Rezension hinterlassen
      w\xFCrdest! Als Solo-Entwickler hilft mir jedes Feedback, das Spiel zu verbessern
      und dir weiterhin einzigartige R\xE4tsel zu bieten!"
    m_Metadata:
      m_Items: []
  - m_Id: 37606061599117312
    m_Localized: Bewerten / Rezensionschreiben
    m_Metadata:
      m_Items: []
  - m_Id: 37606314163326976
    m_Localized: "Sp\xE4ter fragen"
    m_Metadata:
      m_Items: []
  - m_Id: 37606317611044864
    m_Localized: Nicht mehr fragen
