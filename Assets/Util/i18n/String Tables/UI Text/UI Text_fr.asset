    m_Metadata:
      m_Items: []
  - m_Id: 12008259829649408
    m_Localized: TOUS
    m_Metadata:
      m_Items: []
  - m_Id: 16543813208395776
    m_Localized: "Bienvenue !\r\n\nOn dirait que vous \xEAtes nouveau ici. Voulez-vous
      visiter le tutoriel ?"
    m_Metadata:
      m_Items: []
  - m_Id: 19870318709723136
    m_Localized: "Cette application utilise l'identifiant publicitaire de votre appareil
      pour vous proposer des publicit\xE9s personnalis\xE9es plus pertinentes."
    m_Metadata:
      m_Items: []
  - m_Id: 24236018148593664
    m_Localized: "S\xE9rie:"
    m_Metadata:
      m_Items: []
  - m_Id: 24236030270132224
    m_Localized: "Termin\xE9:"
    m_Metadata:
      m_Items: []
  - m_Id: 24236072167034880
    m_Localized: "Prolongez votre s\xE9rie quotidienne en terminant 3 puzzles quotidiens
      par jour."
    m_Metadata:
      m_Items: []
  - m_Id: 27534971216613376
    m_Localized: Restaurer les achats
    m_Metadata:
      m_Items: []
  - m_Id: 27534710855192576
    m_Localized: "Les achats n'ont pas pu \xEAtre restaur\xE9s"
    m_Metadata:
      m_Items: []
  - m_Id: 27538739295440896
    m_Localized: "Achats restaur\xE9s !"
    m_Metadata:
      m_Items: []
  - m_Id: 27553899598860288
    m_Localized: Gestion
    m_Metadata:
      m_Items: []
  - m_Id: 37602962650189824
    m_Localized: Vous aimez le jeu ?
    m_Metadata:
      m_Items: []
  - m_Id: 37603949989351424
    m_Localized: "Je serais honor\xE9 si vous laissiez une note ou un avis ! En tant
      que d\xE9veloppeur solo, tout retour m\u2019aide \xE0 am\xE9liorer le jeu et
      \xE0 continuer \xE0 vous proposer des casse-t\xEAtes uniques !"
    m_Metadata:
      m_Items: []
